# --- חובה ---
TELEGRAM_BOT_TOKEN=123456:ABC...        # מ-@BotFather
PHONE_TOKEN=שים-כאן-סיסמה-ארוכה-ואקראית   # הטלפון שולח אותה עם כל דיווח

# --- אופציונלי ---
ANTHROPIC_API_KEY=                      # אם ריק: הבוט משתמש בנוסחים מוכנים מראש
CLAUDE_MODEL=claude-haiku-5-5
TZ=Asia/Jerusalem
PORT=8080
DB_PATH=data/focus.db

# ברירות מחדל (אפשר לשנות מהבוט עם /limit)
DAILY_LIMIT_MIN=120
SOCIAL_LIMIT_MIN=45
SOCIAL_APPS=Instagram,TikTok,Facebook,X,Twitter,Snapchat,YouTube,Reddit,Threads

# שעות
MORNING_TIME=08:00
CHECKIN_TIMES=10:30,13:00,15:30,18:00,20:30
EVENING_TIME=21:30
CHECKIN_TIMEOUT_MIN=20
